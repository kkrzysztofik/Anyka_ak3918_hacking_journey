+    use std::fs::OpenOptions;
+
+    let configdata_pm = build_dir.join("configdata.pm");
+    if configdata_pm.exists() {
+        // Open in append mode to update timestamp without truncating
+        let _ = OpenOptions::new().append(true).open(&configdata_pm);
+    }
+    // Also touch Makefile to ensure consistency
+    let makefile = build_dir.join("Makefile");
+    if makefile.exists() {
