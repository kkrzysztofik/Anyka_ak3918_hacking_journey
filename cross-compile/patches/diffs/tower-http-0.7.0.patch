+#[cfg(test)]
+mod armv5_rate_limit_tests {
+    use super::armv5_rate_limited_deadline;
+
+    #[test]
+    fn saturated_clock_and_interval_are_terminal() {
+        assert_eq!(
+            armv5_rate_limited_deadline(u32::MAX, u32::MAX, u32::MAX),
+            None,
+            "saturated clock and next must not schedule another call"
+        );
+        assert_eq!(
+            armv5_rate_limited_deadline(u32::MAX, 0, u32::MAX),
+            Some(u32::MAX),
+            "first fire after clock saturation stores the terminal sentinel"
+        );
+        assert_eq!(
+            armv5_rate_limited_deadline(u32::MAX, u32::MAX, 1),
+            None,
+            "once next is MAX, further intervals stay terminal"
+        );
+    }
