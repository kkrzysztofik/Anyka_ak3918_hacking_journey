+/// Next `rate_limited!` deadline for ARMv5TEJ (`AtomicU32` seconds).
+///
+/// `u32::MAX` is a terminal sentinel. Once the stored deadline saturates,
+/// later invocations must not CAS an unchanged `MAX` and fire `$call` again.
+#[allow(dead_code)]
+pub(crate) fn armv5_rate_limited_deadline(now: u32, next: u32, interval_secs: u32) -> Option<u32> {
+    if next == u32::MAX {
+        None
+    } else if now >= next {
+        Some(now.saturating_add(interval_secs))
+    } else {
+        None
+    }
+}
+
