{
  // Rust-analyzer configuration for cross-compilation project
  // Use system rustc for IDE features while keeping custom toolchain for builds
  "rust-analyzer.server.extraEnv": {
    // Override RUSTC to use system rustc for rust-analyzer
    "RUSTC": "rustc"
  },
  "rust-analyzer.cargo.extraEnv": {
    // Override RUSTC for cargo check operations
    "RUSTC": "rustc"
  },
  // Use system rustc path for rust-analyzer operations
  "rust-analyzer.rustc.source": "discover",
  // Keep using the project's target for analysis
  "rust-analyzer.cargo.target": "armv5te-unknown-linux-uclibceabi",
  // Memory management - limit rust-analyzer to prevent WSL crashes
  "rust-analyzer.server.memoryLimit": 2048,
  "rust-analyzer.checkOnSave.timeout": 30000,
  // Disable expensive features to reduce memory footprint
  "rust-analyzer.cargo.allFeatures": false,
  "rust-analyzer.inlayHints.enable": false,
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.inlayHints.closingBraceHints.enable": false,
  "rust-analyzer.inlayHints.lifetimeElisionHints.enable": false,
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "rust-analyzer.procMacro.enable": false,
  "rust-analyzer.completion.autoimport.enable": false,
  "rust-analyzer.completion.privateEditable": false,
  "rust-analyzer.semanticTokens.enable": false,
  // Use cargo check for faster feedback
  "rust-analyzer.check.command": "check",
  // Additional helpful settings
  "rust-analyzer.diagnostics.enable": true,
  "sonarlint.connectedMode.project": {
    "connectionId": "kkrzysztofik",
    "projectKey": "kkrzysztofik_Anyka_ak3918_hacking_journey"
  },
  "chat.tools.terminal.autoApprove": {
    "/home/azureuser/anyka-dev/toolchain/arm-anykav200-crosstool-ng/bin/cargo": true,
    "/home/azureuser/anyka-dev/toolchain/arm-anykav200-crosstool-ng/bin/arm-unknown-linux-uclibcgnueabi-nm": true
  }
}