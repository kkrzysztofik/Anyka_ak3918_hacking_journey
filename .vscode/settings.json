{
  // Rust-analyzer configuration for cross-compilation project
  // linkedProjects: ${workspaceFolder} equals ANYKA_REPO_ROOT after `source ./setenv.sh` at repo root
  // Use system rustc and x86_64 target for IDE analysis
  "rust-analyzer.server.extraEnv": {
    // Override RUSTC to use system rustc for rust-analyzer
    "RUSTC": "rustc",
    // Explicitly name the stable toolchain (empty string is unreliable)
    "RUSTUP_TOOLCHAIN": "stable"
  },
  "rust-analyzer.cargo.extraEnv": {
    // Override RUSTC for cargo check operations
    "RUSTC": "rustc"
  },
  // Use system rustc path for rust-analyzer operations
  "rust-analyzer.rustc.source": "discover",
  // Use x86_64 target for analysis (not ARM) as per project standards
  "rust-analyzer.cargo.target": "x86_64-unknown-linux-gnu",
  // Portable path (same tree as setenv.sh ANYKA_REPO_ROOT)
  "rust-analyzer.linkedProjects": [
    "${workspaceFolder}/cross-compile/Cargo.toml"
  ],
  // Specify target explicitly in cargo commands
  "rust-analyzer.cargo.extraArgs": [
    "--target",
    "x86_64-unknown-linux-gnu"
  ],
  "rust-analyzer.cargo.allTargets": false,
  "rust-analyzer.cargo.buildScripts.enable": false,
  "rust-analyzer.check.extraArgs": [
    "--target",
    "x86_64-unknown-linux-gnu",
    "--no-deps"
  ],
  // Memory optimization: reduce LRU cache from default 128
  "rust-analyzer.lru.capacity": 64,
  // Memory optimization: limit analysis threads (default uses all cores)
  "rust-analyzer.numThreads": 2,
  // Memory optimization: disable experimental diagnostics
  "rust-analyzer.diagnostics.experimental.enable": false,
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.inlayHints.closingBraceHints.enable": false,
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "rust-analyzer.procMacro.enable": true,
  "rust-analyzer.completion.autoimport.enable": false,
  "rust-analyzer.files.watcherExclude": [
    "**/target/**",
    "**/.git/**",
    "**/cross-compile/patches/**",
    "**/cross-compile/**/out/**"
  ],
  // Use cargo check for faster feedback
  "rust-analyzer.check.command": "check",
  // Additional helpful settings
  "rust-analyzer.diagnostics.enable": true,
  // Integrated terminal: load vendored toolchain via setenv.sh (see terminal-anyka.bashrc)
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash"
    },
    "Anyka (setenv)": {
      "path": "bash",
      "args": [
        "--rcfile",
        "${workspaceFolder}/.vscode/terminal-anyka.bashrc"
      ],
      "icon": "terminal-bash"
    }
  },
  "terminal.integrated.defaultProfile.linux": "Anyka (setenv)",
  "sonarlint.connectedMode.project": {
    "connectionId": "kkrzysztofik",
    "projectKey": "kkrzysztofik_Anyka_ak3918_hacking_journey"
  },
  "sonarlint.ls.vmargs": "-Xms128m -Xmx512m",
  "sonarlint.output.showVerboseLogs": false,
  "sonarlint.trace.server": "off",
  "chat.tools.terminal.autoApprove": {
    "${workspaceFolder}/toolchain/arm-anykav200-crosstool-ng/bin/cargo": true,
    "${workspaceFolder}/toolchain/arm-anykav200-crosstool-ng/bin/arm-unknown-linux-uclibcgnueabi-nm": true,
    "cargo fmt": true,
    "npm run type-check": true,
    "npm run test": true,
    "cargo audit": true,
    "bd": true,
    // Approve `bd list` with optional flags and shell pipelines (e.g. `--json`, `| head`).
    // A single long regex for the JSON+Python one-liner was hard to maintain; this pattern
    // still matches the common automation shape without encoding the full pipeline.
    "/\\bbd\\s+list\\b/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "cursorpyright.analysis.typeCheckingMode": "strict",
  "cursorpyright.analysis.diagnosticMode": "workspace"
}
