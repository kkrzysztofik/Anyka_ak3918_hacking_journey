toolchain/arm-anykav200-crosstool-ng/**/*
toolchain/cargo-home/
.cargo-targets/
toolchain/aarch64-unknown-linux-gnu-toolchain/**/*
toolchain/go-custom-armv5/**/*
toolchain/go-source/**/*
toolchain/toolchain-builder/rust/**/*
toolchain/toolchain-builder/build/**/*
toolchain/toolchain-builder/.build/**/*
toolchain/toolchain-builder/llvm-*/**/*
