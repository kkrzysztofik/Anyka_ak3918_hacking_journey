cross-compile/onvif/tests/coverage/**/*

cross-compile/rust-hello/.cargo/**/*
cross-compile/rust-hello/target/**/*

# Rust ONVIF workspace outputs
cross-compile/onvif-rust/.cargo/**/*
!cross-compile/onvif-rust/.cargo/config.toml.template
cross-compile/onvif-rust/target/**/*
cross-compile/onvif-rust/debug/**/*
cross-compile/onvif-rust/release/**/*
cross-compile/onvif-rust/coverage/**/*
cross-compile/onvif-rust/**/*.rs.bk
cross-compile/onvif-rust/**/*.rlib
